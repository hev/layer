FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY tools/sdk-harness/package.json tools/sdk-harness/package-lock.json tools/sdk-harness/
RUN npm ci --prefix tools/sdk-harness
COPY clients/python/ clients/python/
RUN python3 -m venv /venv && /venv/bin/pip install ./clients/python
COPY clients/typescript/ clients/typescript/
COPY tools/sdk-harness/test/pgvector/ tools/sdk-harness/test/pgvector/
COPY scripts/test-pgvector-clients.sh scripts/
ENV PATH="/venv/bin:${PATH}"
CMD ["scripts/test-pgvector-clients.sh"]

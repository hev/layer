# hev layer CE — copy to .env and fill in the required values.
# Gateway only: docker compose up
# Dashboard:    docker compose --profile dashboard up
HEVLAYER_LICENSE=
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=aws-us-east-1
DASHBOARD_BASIC_AUTH_USER=ops
DASHBOARD_BASIC_AUTH_PASSWORD=

# Host ports (container ports stay 8080, 8081, and 9090).
GATEWAY_PORT=8080
DASHBOARD_PORT=8081
PROMETHEUS_PORT=9090

# Optional image overrides.
GATEWAY_IMAGE=hevlayer/layer-gateway:latest
DASHBOARD_IMAGE=hevlayer/layer-dashboard:latest
# The published dashboard image is currently amd64-only. Docker Desktop can emulate it on arm64.
DASHBOARD_PLATFORM=linux/amd64

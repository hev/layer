# hev layer CE — copy to .env and fill in the required values.
#   docker compose up
HEVLAYER_LICENSE=
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=aws-us-east-1

# Host port (container port stays 8080).
GATEWAY_PORT=8080

# Optional image override. Blank uses the released image; set
# hevlayer/layer-gateway:edge to opt into the development build.
GATEWAY_IMAGE=

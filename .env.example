# hev layer CE — the Layer gateway on your turbopuffer account.
# Copy to .env, set TURBOPUFFER_API_KEY, then:
#   docker compose up -d --wait
# Required: your turbopuffer API key. The gateway exits at startup without it.
# Clients send the same key as `Authorization: Bearer <key>`.
TURBOPUFFER_API_KEY=

# Optional Layer license key.
HEVLAYER_LICENSE=

# Host port (container port stays 8080).
GATEWAY_PORT=8080

# Optional image override. Blank uses the released image; set
# hevlayer/layer-gateway:edge to opt into the development build.
GATEWAY_IMAGE=

# Optional embedding sidecar image override. Blank uses the pinned image;
# set hevlayer/layer-embed:edge to opt into the development build.
EMBED_IMAGE=

{
  "name": "hevlayer",
  "version": "0.8.0",
  "description": "Typed TypeScript client for the hevlayer gateway",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./edge": {
      "types": "./edge/index.d.ts",
      "import": "./edge/index.js"
    },
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "edge/index.js",
    "edge/index.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .tmp-test && tsc -p tsconfig.test.json && node --test .tmp-test/test/client.test.js && node --experimental-wasm-modules --test edge/edge.test.js"
  },
  "dependencies": {
    "micropuffer": "0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}

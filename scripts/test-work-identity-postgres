#!/usr/bin/env bash
set -euo pipefail

test=work_identity_authenticated_transactions
if (($# != 0)); then
    if [[ $# != 2 || $1 != -- || ! -x $2 ]]; then
        echo 'Usage: scripts/test-work-identity-postgres [-- /path/to/client-check]' >&2
        exit 2
    fi
    WORK_IDENTITY_FIXTURE_CLIENT=$(realpath "$2")
    export WORK_IDENTITY_FIXTURE_CLIENT
    test=work_identity_fixture_client
fi

cd "$(dirname "$0")/.."

# On a containerized CI runner Docker publishes ports on the host.
# Bind its private bridge gateway so the runner can connect.
bind_host=127.0.0.1
if [[ ${GITHUB_ACTIONS:-} == true && -f /.dockerenv ]]; then
    hex=$(awk '$2 == "00000000" && $1 != "Iface" { print $3; exit }' /proc/net/route)
    if [[ ! $hex =~ ^[[:xdigit:]]{8}$ || $hex == 00000000 ]]; then
        echo 'Cannot resolve the Docker host bridge gateway' >&2
        exit 1
    fi
    bind_host="$((16#${hex:6:2})).$((16#${hex:4:2})).$((16#${hex:2:2})).$((16#${hex:0:2}))"
fi

# Only the disposable container gets these synthetic fixture credentials.
fixture_password=$(od -An -N24 -tx1 /dev/urandom | tr -d '[:space:]')
container=$(POSTGRES_PASSWORD="$fixture_password" timeout 90 docker run --rm --detach \
    --env POSTGRES_PASSWORD \
    --publish "$bind_host::5432" postgres:16)
trap 'timeout 20 docker stop "$container" >/dev/null' EXIT

for ((attempt=1; attempt<=30; attempt++)); do
    if timeout 3 docker exec "$container" pg_isready -h 127.0.0.1 -U postgres >/dev/null 2>&1; then
        break
    fi
    if ((attempt == 30)); then
        echo 'Disposable Postgres did not become ready' >&2
        exit 1
    fi
    sleep 1
done

timeout 15 docker cp apps/layer-gateway/migrations/work-identity "$container:/tmp/work-identity"
scripts/test-work-identity-migration "$container"
# The disposable role uses the same synthetic password as the fixture admin.
printf "ALTER ROLE identity_runtime PASSWORD '%s';\n" "$fixture_password" |
    timeout 15 docker exec -i "$container" psql -X -v ON_ERROR_STOP=1 -U postgres

socket=$(timeout 5 docker port "$container" 5432/tcp)
export WORK_IDENTITY_FIXTURE_ADMIN_URL="postgres://postgres:${fixture_password}@${socket}/postgres?sslmode=disable"
export LAYER_WORK_IDENTITY_DATABASE_URL="postgres://identity_runtime:${fixture_password}@${socket}/postgres?sslmode=disable"
export LAYER_TELEMETRY=off
cargo test --locked -p hevlayer-gateway --features work-identity --test work_identity --jobs 8 \
    "$test" -- --ignored --exact --nocapture
